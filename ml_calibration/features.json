{
  "version": "5.2",
  "description": "NASA Exoplanet Archive + Kopparapu (2013) conservative HZ habitability features",
  "created": "2026-05-20",
  "model_type": "XGBoost Regressor",
  "target": "Relative habitability score (0-1); display index Earth reference = 100",
  "hz_model": "kopparapu_2013_conservative_rv_em",
  "display_scale": "earth_reference_index",

  "features": [
    {"name": "pl_rade", "index": 0, "units": "R⊕", "source": "NASA", "range": [0.1, 20.0]},
    {"name": "pl_masse", "index": 1, "units": "M⊕", "source": "NASA", "range": [0.001, 500.0]},
    {"name": "pl_orbper", "index": 2, "units": "days", "source": "NASA", "range": [0.1, 100000.0]},
    {"name": "pl_orbsmax", "index": 3, "units": "AU", "source": "NASA", "range": [0.01, 1000.0]},
    {"name": "pl_orbeccen", "index": 4, "units": "unitless", "source": "NASA", "range": [0.0, 1.0]},
    {"name": "pl_insol", "index": 5, "units": "S⊕", "source": "NASA / L/a²", "range": [0.0001, 100.0]},
    {"name": "pl_eqt", "index": 6, "units": "K", "source": "NASA", "range": [50.0, 3000.0]},
    {"name": "pl_dens", "index": 7, "units": "g/cm³", "source": "NASA / M,R", "range": [0.1, 30.0]},
    {"name": "st_teff", "index": 8, "units": "K", "source": "NASA stellar_hosts", "range": [2000.0, 50000.0]},
    {"name": "st_mass", "index": 9, "units": "M☉", "source": "NASA", "range": [0.08, 100.0]},
    {"name": "st_rad", "index": 10, "units": "R☉", "source": "NASA", "range": [0.1, 1000.0]},
    {"name": "st_lum", "index": 11, "units": "L☉", "source": "NASA / Stefan-Boltzmann", "range": [0.0001, 1000000.0]},
    {"name": "hz_inner_au", "index": 12, "units": "AU", "source": "K13 Recent Venus", "range": [0.001, 1000.0]},
    {"name": "hz_outer_au", "index": 13, "units": "AU", "source": "K13 Early Mars", "range": [0.001, 1000.0]},
    {"name": "hz_lin_pos", "index": 14, "units": "0–1", "source": "K13 orbital position", "range": [0.0, 1.0]},
    {"name": "s_eff_log_pos", "index": 15, "units": "0–1", "source": "K13 log-flux position", "range": [0.0, 1.0]},
    {"name": "in_hz", "index": 16, "units": "0/1", "source": "K13 inside conservative HZ", "range": [0.0, 1.0]},
    {"name": "st_met", "index": 17, "units": "[Fe/H] dex", "source": "NASA stellar_hosts", "range": [-2.5, 1.0]},
    {"name": "sy_snum", "index": 18, "units": "count", "source": "NASA system", "range": [1.0, 6.0]},
    {"name": "s_eff_inner", "index": 19, "units": "S⊕", "source": "K13 Table 3 S_eff (RV)", "range": [0.01, 100.0]},
    {"name": "insol_vs_rv", "index": 20, "units": "ratio", "source": "pl_insol / S_eff_RV (K13)", "range": [0.001, 50.0]},
    {"name": "flux_ecc_ratio", "index": 21, "units": "ratio", "source": "√((1+e)/(1-e)) peri/mean flux", "range": [1.0, 5.0]},
    {"name": "tidal_lock_proxy", "index": 22, "units": "0–1", "source": "orbital period heuristic", "range": [0.0, 1.0]}
  ],

  "notes": [
    "Training labels: physics teacher (NASA + K13), not life probability",
    "Display index: 100 × (raw / Earth_reference_raw) — Earth is the defined baseline",
    "K13: Kopparapu et al. 2013 ApJ 765,131 — Recent Venus inner, Early Mars outer"
  ]
}
